{
  "name": "@claude-desktop/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Claude Desktop — Codex-style UI for Claude Code + local CPA",
  "author": "claude-desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
