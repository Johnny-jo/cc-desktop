{
  "name": "claude-desktop",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @claude-desktop/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "prepare:vendor:cpa": "node scripts/prepare-vendor.mjs --cpa-only",
    "package:win": "pnpm prepare:vendor && pnpm --filter @claude-desktop/desktop package:win",
    "package:win:app": "pnpm --filter @claude-desktop/desktop package:win",
    "package:win:cpa": "pnpm prepare:vendor:cpa && pnpm --filter @claude-desktop/desktop package:win"
  }
}
